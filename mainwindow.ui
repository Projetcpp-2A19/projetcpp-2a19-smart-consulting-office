           <property name="styleSheet">
            <string notr="true">QTextEdit:focus {
    border: 2px solid #3498db;
    background-color: white;
}


QTextEdit {
    background-color: #1e1e1e;  /* Fond noir */
    color: #ffffff;  /* Texte blanc */
    border: 1px solid #333333;  /* Bordure grise */

    selection-background-color: #444444; /* Couleur de sélection */
}
QTextEdit {
    background-color: #ffffff;
    color: #222222;
    font-size: 14px;
    border: 2px solid #aaaaaa;

    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3); /* Ombre */

}
</string>
