     <property name="styleSheet">
      <string notr="true">QTabWidget::pane {
    border: 2px solid #3498db; /* Bordure autour du widget */
    background: white;
    border-radius: 5px;
}

QTabBar::tab {
    background: #ecf0f1; /* Fond gris clair */
    border: 2px solid #bdc3c7;
    border-radius: 5px;
    padding: 8px 15px;
    font-size: 14px;
    color: #2c3e50; /* Gris foncé */
}

QTabBar::tab:selected {
    background: #3498db; /* Bleu pour l'onglet actif */
    color: white;
    border: 2px solid #2980b9;
}

QTabBar::tab:hover {
    background: #5dade2; /* Bleu clair au survol */
}
</string>
